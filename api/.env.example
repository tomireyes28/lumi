# ==============================================================================
# Lumi API - Environment Variables Template
# Copy this file to .env and replace placeholder values with your credentials.
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development
# Optional: Set TRUST_PROXY=1 only when deployed behind a trusted reverse proxy
# TRUST_PROXY=1

# Frontend Client URL (Used for CORS and OAuth redirects)
FRONTEND_URL=http://localhost:3001

# PostgreSQL Database (Supabase or local PostgreSQL)
# Example for local Docker: postgresql://postgres:postgres@localhost:5432/lumi_db?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Authentication / JWT
JWT_SECRET=your_super_secret_jwt_key_min_32_characters

# Google OAuth 2.0 Credentials (Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Optional: Email Notifications Service (Resend HTTP API)
# Leave unset or as placeholder in local development to run in dry-run mode
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL="Lumi Finanzas <onboarding@resend.dev>"

# Server-only proxy signing key: same random value (32+ characters) in both services.
# Generate privately; never prefix with NEXT_PUBLIC_ or commit its value.
LUMI_PROXY_SECRET=
