generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  authVersion Int @default(0)
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  password      String?  // Opcional si inicia sesión exclusivamente con proveedor OAuth
  picture       String?
  googleId      String?  @unique
  emailVerified Boolean  @default(false)

  sessions AuthSession[]
  transactions Transaction[]
  categories   Category[]
  creditCards  CreditCard[]
  reminders    Reminder[]
  budgets      Budget[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Category {
  id           String        @id @default(uuid())
  userId       String
  name         String
  type         String        // 'income' | 'expense'
  colorHex     String?       // Para los colores pasteles
  icon         String?
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]
  createdAt    DateTime      @default(now())

  @@index([userId])
}

model Transaction {
  id                 String    @id @default(uuid())
  userId             String
  categoryId         String
  amount             Decimal   @db.Decimal(10, 2)
  date               DateTime  @default(now())
  note               String?
  paymentMethod      String    @default("cash") // 'cash' | 'credit_card'
  installmentGroupId String?

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt    DateTime    @default(now())
  creditCardId String?     // Relación opcional con CreditCard
  creditCard   CreditCard? @relation(fields: [creditCardId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([userId, categoryId])
  @@index([userId, creditCardId])
  @@index([userId, installmentGroupId])
}

model CreditCard {
  id         String  @id @default(uuid())
  alias      String  // Ej: "Visa Galicia"
  lastFour   String  // Ej: "4567"
  limit      Decimal @db.Decimal(10, 2)
  closingDay Int
  dueDay     Int
  colorHex   String? @default("#0f172a")

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[]
  cycles       CardCycle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model CardCycle {
  id           String     @id @default(uuid())
  creditCardId String
  creditCard   CreditCard @relation(fields: [creditCardId], references: [id], onDelete: Cascade)

  month       Int       // 1 a 12 (mes del resumen/cierre)
  year        Int       // Año del ciclo (ej: 2026)
  closingDate DateTime  // Fecha exacta de cierre para este mes
  dueDate     DateTime? // Fecha exacta de vencimiento para este ciclo (opcional)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([creditCardId, year, month])
  @@index([creditCardId])
}

model Reminder {
  id          String   @id @default(uuid())
  title       String   // Ej: "Alquiler", "Netflix"
  amount      Decimal? @db.Decimal(10, 2)
  dueDate     DateTime // La fecha en la que vence
  isPaid      Boolean  @default(false)
  isRecurring Boolean  @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([dueDate])
}

model Budget {
  id         String   @id @default(uuid())
  userId     String
  categoryId String
  amount     Decimal  @db.Decimal(10, 2)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, categoryId])
  @@index([userId])
}

model AuthSession {
  authVersion Int @default(0)
  id String @id
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([expiresAt])
}

model OAuthGrant {
 id String @id
 kind String
 payload Json
 expiresAt DateTime
 @@index([expiresAt])
}

model RateLimitBucket {
 id String @id
 hits Int
 resetsAt DateTime
 blockedUntil DateTime?
 @@index([resetsAt])
}
