# ==============================================================================
# Lumi Web - Environment Variables Template
# Copy this file to .env.local and replace placeholder values.
# ==============================================================================

# Backend API Base URL
NEXT_PUBLIC_API_URL=http://localhost:3000

# Site URL (for metadata base and OpenGraph)
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Server-only proxy signing key: same random value (32+ characters) in both services.
# Generate privately; never prefix with NEXT_PUBLIC_ or commit its value.
LUMI_PROXY_SECRET=
